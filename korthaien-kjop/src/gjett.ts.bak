import { db, normaliser } from "./db.js";

// ─────────────────────────────────────────────────────────────────────────────
// GJETT SETT FRA INNHOLD
// ─────────────────────────────────────────────────────────────────────────────
// Rundt 280 kategorier har verken settnavn eller forelder i Mystore. «Common»
// uten noe over seg forteller ingenting, og informasjonen finnes ikke i API-et
// — den er ikke skjult, den er borte.
//
// Men kortene inne i kategorien vet svaret. Ligger det 80 kort der og 78 av
// dem finnes i Invasion, er kategorien Invasion. Vi teller treff per sett og
// krever et tydelig flertall før vi foreslår noe.

export type Kandidat = {
  set_code: string;
  set_name: string;
  treff: number;
  andel: number;
};

export type Gjetning = {
  antallKort: number;
  kandidater: Kandidat[];
  sikker: Kandidat | null;
};

// Et kort som «Lightning Bolt» finnes i femti sett, så enkelttreff sier lite.
// Det er fordelingen over hele utvalget som avgjør: riktig sett inneholder
// nesten alle navnene, feil sett bare de vanligste kortene.
const MIN_KORT = 8;
const MIN_ANDEL = 0.75;
const MIN_MARGIN = 1.5; // beste må være klart foran nest beste

export async function gjettSett(navn: string[]): Promise<Gjetning> {
  const normer = [...new Set(navn.map((n) => normaliser(reinsk(n))).filter((n) => n.length > 1))];
  if (!normer.length) return { antallKort: 0, kandidater: [], sikker: null };

  const plass = normer.map(() => "?").join(",");
  const r = await db().execute({
    sql: `SELECT c.set_code, s.name AS set_name, COUNT(DISTINCT c.name_norm) AS treff
            FROM cards c LEFT JOIN sets s ON s.code = c.set_code
           WHERE c.name_norm IN (${plass}) OR c.front_norm IN (${plass})
           GROUP BY c.set_code
           ORDER BY treff DESC
           LIMIT 5`,
    args: [...normer, ...normer],
  });

  const kandidater: Kandidat[] = r.rows.map((x: any) => ({
    set_code: String(x.set_code),
    set_name: String(x.set_name || x.set_code),
    treff: Number(x.treff),
    andel: Number(x.treff) / normer.length,
  }));

  let sikker: Kandidat | null = null;
  const beste = kandidater[0];
  const nest = kandidater[1];
  if (
    beste &&
    normer.length >= MIN_KORT &&
    beste.andel >= MIN_ANDEL &&
    (!nest || beste.treff >= nest.treff * MIN_MARGIN)
  ) {
    sikker = beste;
  }

  return { antallKort: normer.length, kandidater, sikker };
}

// Butikknavn har ofte tilleggsord som ikke står på kortet.
function reinsk(navn: string): string {
  return String(navn || "")
    .replace(/\bfoil\b/gi, "")
    .replace(/\([^)]*\)/g, "")
    .trim();
}
