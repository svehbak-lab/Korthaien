# Database. Tom = lokal fil, fint for utvikling i Codespaces.
DATABASE_URL=file:./korthaien-kjop.db
# I produksjon: libsql://<db>.turso.io + token
# DATABASE_AUTH_TOKEN=

# Admin
ADMIN_PASSWORD=bytt-meg
SESSION_SECRET=langt-tilfeldig-tegn-her

# Frontend-adresse(r), komma-separert
CORS_ORIGIN=http://localhost:5173,https://kortsalg.korthaien.no,https://admin.korthaien.no

# Sett til 1 bare hvis admin og API ligger på ulike domener.
# COOKIE_CROSS_SITE=1

# Mystore. Uten disse regnes beholdningen som 0.
MYSTORE_URL=https://korthaien.mystore.no/api/v1
MYSTORE_KEY=
